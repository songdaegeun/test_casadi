% fHistory.m

jsonText = fileread('x0_x_opt.json');
data = jsondecode(jsonText);

num_horizon = 10;  

% figure 초기화
figure;
for h = 1:num_horizon
    subplot(2, 5, h);
    hold on;
    grid on;
    xlabel('Step');
    ylabel('Cost');
end

%for t = 1:length(data)
for t = 121:
    time_step = data(t).time_step;
    horizon_steps = data(t).horizon_steps;

    for h = 1:length(horizon_steps)
        step_data = horizon_steps(h);
        cost = step_data.cost;
        initial_x = step_data.initial_x;
        optimal_x = step_data.optimal_x;
        % print optimal_x
        %for i = 1:length(optimal_x)
        %    fprintf('optimal_x: %f\n', optimal_x(i));
        %end
        %fprintf('initial_x: %f\n', initial_x(13));
        fprintf('optimal_x: %f\n', optimal_x(13));
        steps = 1:length(cost);

        subplot(2, 5, h);
        plot(steps, cost, '-', 'DisplayName', sprintf('t=%d', time_step));

        % initial_x(1), optimal_x(1)
        %title(sprintf('Step %d\n', h-1));
    end
end
for h = 1:10
    subplot(2, 5, h);
    %legend('show');
end

